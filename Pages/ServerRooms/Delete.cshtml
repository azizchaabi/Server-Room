@page
@model ServerRoomMonitor.Pages.ServerRooms.DeleteModel

@{
    ViewData["Title"] = "Delete Server Room";
}

<div class="container mt-4">

    <h1>Delete Server Room</h1>

    <div class="alert alert-danger mt-4">
        <h4>Are you sure you want to delete this server room?</h4>

        <p class="mb-0">
            This action cannot be undone.
        </p>
    </div>

    <div class="card mt-4">
        <div class="card-body">

            <h5 class="card-title">
                @Model.ServerRoom.Name
            </h5>

            <p class="card-text">
                <strong>Location:</strong>
                @Model.ServerRoom.Location
            </p>

        </div>
    </div>

    <form method="post" class="mt-4">

        <input type="hidden" asp-for="ServerRoom.Id" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-page="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>
