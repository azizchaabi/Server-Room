@page
@model ServerRoomMonitor.Pages.ServerRooms.DetailsModel

@{
    ViewData["Title"] = "Server Room Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>@Model.ServerRoom.Name</h1>

            <p class="text-muted mb-0">
                <strong>Location:</strong>
                @Model.ServerRoom.Location
            </p>
        </div>

        <div>
            <a asp-page="Edit"
               asp-route-id="@Model.ServerRoom.Id"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-page="Index"
               class="btn btn-secondary">
                Back
            </a>
        </div>

    </div>

    <hr />

    <h2 class="mb-3">Inspection History</h2>

    @if (!Model.ServerRoom.Inspections.Any())
    {
        <div class="alert alert-info">
            No inspections have been performed for this server room yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-bordered">

                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Temperature</th>
                        <th>Temperature OK</th>
                        <th>Overall Status</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var inspection in Model.ServerRoom.Inspections
                        .OrderByDescending(i => i.CheckedAt))
                    {
                        <tr>

                            <td>
                                @inspection.CheckedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @inspection.Temperature °C
                            </td>

                            <td>
                                @if (inspection.TemperatureOk)
                                {
                                    <span class="badge bg-success">
                                        OK
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Not OK
                                    </span>
                                }
                            </td>

                            <td>
                                @if (inspection.IsOk)
                                {
                                    <span class="badge bg-success">
                                        OK
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Not OK
                                    </span>
                                }
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
