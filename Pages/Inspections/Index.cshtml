@page
@model ServerRoomMonitor.Pages.Inspections.IndexModel

@{
ViewData["Title"] = "Inspection History";
}

<div class="container mt-4">


<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1>@Model.ServerRoom?.Name</h1>

        <p class="text-muted mb-0">
            Location: @Model.ServerRoom?.Location
        </p>
    </div>

    @if (User.IsInRole("Technician"))
    {
        <a asp-page="/Inspections/Create"
           asp-route-serverRoomId="@Model.ServerRoom.Id"
           class="btn btn-primary">
            New Inspection
        </a>
    }

</div>

<h3>Inspection History</h3>

@if (!Model.Inspections.Any())
{
    <div class="alert alert-info mt-3">
        No inspections have been recorded for this server room yet.
    </div>
}
else
{
    <div class="table-responsive mt-3">

        <table class="table table-bordered table-hover align-middle">

            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Temperature</th>
                    <th>Overall Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var inspection in Model.Inspections)
                {
                    <tr>

                        <td>
                            @inspection.CheckedAt.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @inspection.Temperature °C

                            @if (inspection.TemperatureOk)
                            {
                                <span class="badge bg-success ms-2">
                                    OK
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger ms-2">
                                    Not OK
                                </span>
                            }
                        </td>

                        <td>
                            @if (inspection.IsOk)
                            {
                                <span class="badge bg-success">
                                    OK
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Attention required
                                </span>
                            }
                        </td>

                        <td>
                            <a asp-page="/Inspections/Details"
                               asp-route-id="@inspection.Id"
                               class="btn btn-outline-primary btn-sm">
                                Details
                            </a>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}

<a asp-page="/ServerRooms/Index"
   class="btn btn-secondary mt-3">
    Back to Server Rooms
</a>


</div>
