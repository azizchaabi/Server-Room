@page "{id:int}"
@model ServerRoomMonitor.Pages.Inspections.DetailsModel

@{
    ViewData["Title"] = "Inspection Details";
}

<div class="container mt-4">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Inspection Details</h1>

            <p class="text-muted mb-0">
                @Model.Inspection.ServerRoom?.Name
                -
                @Model.Inspection.ServerRoom?.Location
            </p>
        </div>

        @if (Model.Inspection.IsOk)
        {
            <span class="badge bg-success fs-6">
                Inspection OK
            </span>
        }
        else
        {
            <span class="badge bg-danger fs-6">
                Attention required
            </span>
        }

    </div>


    <!-- INSPECTION INFORMATION -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>Inspection Information</strong>
        </div>

        <div class="card-body">

            <p>
                <strong>Date:</strong>
                @Model.Inspection.CheckedAt.ToString("dd/MM/yyyy")
            </p>

            <p class="mb-0">
                <strong>Time:</strong>
                @Model.Inspection.CheckedAt.ToString("HH:mm")
            </p>

            <p class="mb-0">
                <strong>Performed by:</strong>
                @(Model.Inspection.Technician?.Email ?? "Not recorded")
            </p>

        </div>

    </div>


    <!-- INSPECTION CHECKS -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>Inspection Checks</strong>
        </div>

        <div class="card-body">

            <div class="row">

                <!-- TEMPERATURE -->

                <div class="col-md-6 mb-3">

                    <strong>Temperature</strong>

                    <div class="mt-1">

                        @Model.Inspection.Temperature °C

                        @if (Model.Inspection.TemperatureOk)
                        {
                            <span class="badge bg-success ms-2">
                                OK
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger ms-2">
                                Not OK
                            </span>
                        }

                    </div>

                </div>


                <!-- AIR CONDITIONING -->

                <div class="col-md-6 mb-3">

                    <strong>Air Conditioning</strong>

                    <div class="mt-1">

                        @if (Model.Inspection.AirConditioningOk)
                        {
                            <span class="badge bg-success">
                                OK
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Not OK
                            </span>
                        }

                    </div>

                </div>


                <!-- OVERHEATING ALARM -->

                <div class="col-md-6 mb-3">

                    <strong>Overheating Alarm</strong>

                    <div class="mt-1">

                        @if (Model.Inspection.NoOverheatingAlarm)
                        {
                            <span class="badge bg-success">
                                No Alarm
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Alarm Detected
                            </span>
                        }

                    </div>

                </div>


                <!-- WATER LEAK -->

                <div class="col-md-6 mb-3">

                    <strong>Water Leak</strong>

                    <div class="mt-1">

                        @if (Model.Inspection.NoWaterLeak)
                        {
                            <span class="badge bg-success">
                                No Leak
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Leak Detected
                            </span>
                        }

                    </div>

                </div>


                <!-- POWER -->

                <div class="col-md-6 mb-3">

                    <strong>Power</strong>

                    <div class="mt-1">

                        @if (Model.Inspection.PowerOk)
                        {
                            <span class="badge bg-success">
                                OK
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Not OK
                            </span>
                        }

                    </div>

                </div>


                <!-- CLEANLINESS -->

                <div class="col-md-6 mb-3">

                    <strong>Room Cleanliness</strong>

                    <div class="mt-1">

                        @if (Model.Inspection.RoomClean)
                        {
                            <span class="badge bg-success">
                                Clean
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Needs Attention
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- TECHNICIAN NOTES -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>Technician Notes</strong>
        </div>

        <div class="card-body">

            @if (string.IsNullOrWhiteSpace(Model.Inspection.Notes))
            {
                <p class="text-muted mb-0">
                    No notes were added for this inspection.
                </p>
            }
            else
            {
                <p class="mb-0">
                    @Model.Inspection.Notes
                </p>
            }

        </div>

    </div>


    <!-- ACTIONS -->

    <div class="d-flex gap-2">

        <a asp-page-handler="Pdf"
           asp-route-id="@Model.Inspection.Id"
           class="btn btn-danger">

            Download PDF Report

        </a>

        <a asp-page="/Inspections/Index"
           asp-route-serverRoomId="@Model.Inspection.ServerRoomId"
           class="btn btn-secondary">

            Back to History

        </a>

    </div>

</div>