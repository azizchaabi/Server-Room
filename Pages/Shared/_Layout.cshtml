<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ServerRoomMonitor</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ServerRoomMonitor.styles.css" asp-append-version="true" />
</head>

<body>

    <!-- =========================================================
         TOP NAVBAR
         ========================================================= -->

    <header class="app-navbar">

        <nav class="navbar">

            <div class="navbar-left">

                <a asp-area="" asp-page="/Index" class="navbar-home">

                    <div class="navbar-logo">
                        SR
                    </div>

                    <span>
                        Server Room Monitor
                    </span>

                </a>

            </div>


            <!-- =================================================
                 LOGIN / LOGOUT
                 ================================================= -->

            <div class="navbar-right">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- LOGGED IN -->

                    <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="logout-form">

                        <button type="submit" class="logout-button">

                            Logout

                        </button>

                    </form>
                }
                else
                {
                    <!-- LOGGED OUT -->

                    <a asp-area="Identity" asp-page="/Account/Login" class="login-button">

                        Login

                    </a>
                }

            </div>

        </nav>

    </header>


    <!-- =========================================================
         APPLICATION LAYOUT
         ========================================================= -->

    <div class="app-layout">

        @if (User.Identity?.IsAuthenticated == true)
        {

            <!-- =================================================
                 ADMIN SIDEBAR
                 ================================================= -->

            @if (User.IsInRole("Admin"))
            {
                <aside class="app-sidebar">

                    <div class="sidebar-menu-title">
                        ADMIN MENU
                    </div>


                    <nav class="sidebar-nav">

                        <!-- DASHBOARD -->

                        <a asp-page="/Admin/Index"
                           class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Index" ? "active" : "")">

                            <span class="nav-icon">
                                ⌂
                            </span>

                            <span>
                                Dashboard
                            </span>

                        </a>


                        <!-- SERVER ROOMS -->

                        <a asp-page="/ServerRooms/Index"
                           class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/ServerRooms/Index" ? "active" : "")">

                            <span class="nav-icon">
                                ▦
                            </span>

                            <span>
                                Server Rooms
                            </span>

                        </a>

                        
                        <!-- SCHEDULING -->
                        <a asp-page="/Admin/ScheduledInspections/Index"
                           class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/ScheduledInspections/Index" ? "active" : "")">
                            <span class="nav-icon">
                                ◷
                            </span>
                            <span>
                                Scheduling
                            </span>
                        </a>

                        <a asp-page="/Admin/Calendar/Index"
                           class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Calendar/Index" ? "active" : "")">

                            <span class="nav-icon">▣</span>

                            <span>Calendar</span>

                        </a>

                        


                        <!-- REPORTS -->

                        <a asp-page="/Reports/Index"
                           class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Reports/Index" ? "active" : "")">

                            <span class="nav-icon">
                                ▤
                            </span>

                            <span>
                                Reports
                            </span>

                        </a>


                        <!-- STATISTICS -->

                        <a asp-page="/Admin/Statistics"
                           class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Statistics" ? "active" : "")">

                            <span class="nav-icon">
                                ▥
                            </span>

                            <span>
                                Statistics
                            </span>

                        </a>


                        <!-- USERS -->

                        <a asp-page="/Admin/Users"
                           class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Users" ? "active" : "")">

                            <span class="nav-icon">
                                ♙
                            </span>

                            <span>
                                Users
                            </span>

                        </a>

                    </nav>


                    <!-- SIDEBAR BOTTOM -->

                    <div class="sidebar-bottom">

                        <a asp-page="/Index">

                            <span>
                                ←
                            </span>

                            Back to application

                        </a>

                    </div>

                </aside>
            }


            <!-- =================================================
                 TECHNICIAN SIDEBAR
                 ================================================= -->

            @if (User.IsInRole("Technician"))
            {
                <aside class="app-sidebar">

                    <div class="sidebar-menu-title">
                        TECHNICIAN MENU
                    </div>


                    <nav class="sidebar-nav">

                        <!-- TECHNICIAN DASHBOARD -->

                        <a asp-page="/Technician/Index"
                           class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Technician/Index" ? "active" : "")">

                            <span class="nav-icon">
                                ⌂
                            </span>

                            <span>
                                Dashboard
                            </span>

                        </a>


                        <!-- SERVER ROOMS -->

                        <a asp-page="/ServerRooms/Index"
                           class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/ServerRooms/Index" ? "active" : "")">

                            <span class="nav-icon">
                                ▦
                            </span>

                            <span>
                                Server Rooms
                            </span>

                        </a>


                        <!-- REPORTS -->

                        <a asp-page="/Reports/Index"
                           class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Reports/Index" ? "active" : "")">

                            <span class="nav-icon">
                                ▤
                            </span>

                            <span>
                                Reports
                            </span>

                        </a>

                    </nav>


                    <!-- SIDEBAR BOTTOM -->

                    <div class="sidebar-bottom">

                        <a asp-page="/Index">

                            <span>
                                ←
                            </span>

                            Back to application

                        </a>

                    </div>

                </aside>
            }

        }


        <!-- =====================================================
             PAGE CONTENT
             ===================================================== -->

        <main class="app-content">

            @RenderBody()

        </main>

    </div>


    <!-- =========================================================
         FOOTER
         ========================================================= -->

    <footer class="app-footer">

        <div>
            © 2026 ServerRoomMonitor
        </div>

        <div>

            <a asp-page="/Privacy">
                Privacy
            </a>

        </div>

    </footer>


    <!-- =========================================================
         SCRIPTS
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>


<style>
    /* =========================================================
    GLOBAL
    ========================================================= */

    * {
    box-sizing: border-box;
    }

    body {
    margin: 0;
    background: #f5f6f9;
    color: #252a30;
    }


    /* =========================================================
    TOP NAVBAR
    ========================================================= */

    .app-navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    height: 64px;
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    box-shadow: 0 2px 8px rgba(32, 37, 43, .03);
    }

    .navbar {
    height: 64px;
    padding: 0 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    }


    /* =========================================================
    NAVBAR LEFT
    ========================================================= */

    .navbar-left {
    display: flex;
    align-items: center;
    }

    .navbar-home {
    display: flex;
    align-items: center;
    gap: 11px;
    color: #252a30;
    text-decoration: none;
    font-size: 14px;
    font-weight: 650;
    transition: .15s ease;
    }

    .navbar-home:hover {
    color: #252a30;
    text-decoration: none;
    }


    /* =========================================================
    NAVBAR LOGO
    ========================================================= */

    .navbar-logo {
    width: 35px;
    height: 35px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #20252b;
    color: white;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .5px;
    box-shadow: 0 3px 8px rgba(32, 37, 43, .12);
    }


    /* =========================================================
    NAVBAR RIGHT
    ========================================================= */

    .navbar-right {
    display: flex;
    align-items: center;
    }


    /* =========================================================
    LOGOUT FORM
    ========================================================= */

    .logout-form {
    margin: 0;
    }


    /* =========================================================
    LOGOUT BUTTON
    ========================================================= */

    .logout-button {
    height: 36px;
    padding: 0 14px;

    border: 1px solid #e1e4e7;
    border-radius: 7px;

    background: #ffffff;
    color: #68717a;

    font-family: inherit;
    font-size: 11px;
    font-weight: 600;

    cursor: pointer;

    transition:
    background .15s ease,
    border-color .15s ease,
    color .15s ease;
    }

    .logout-button:hover {
    background: #f5f6f8;
    border-color: #d7dbe0;
    color: #30363c;
    }


    /* =========================================================
    LOGIN BUTTON
    ========================================================= */

    .login-button {
    height: 36px;
    padding: 0 14px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid #e1e4e7;
    border-radius: 7px;

    background: #ffffff;
    color: #68717a;

    font-family: inherit;
    font-size: 11px;
    font-weight: 600;

    text-decoration: none;

    transition:
    background .15s ease,
    border-color .15s ease,
    color .15s ease;
    }

    .login-button:hover {
    background: #f5f6f8;
    border-color: #d7dbe0;
    color: #30363c;

    text-decoration: none;
    }


    /* =========================================================
    APPLICATION LAYOUT
    ========================================================= */

    .app-layout {
    display: flex;
    min-height: calc(100vh - 64px);
    }


    /* =========================================================
    SIDEBAR
    ========================================================= */

    .app-sidebar {
    width: 225px;
    flex-shrink: 0;

    display: flex;
    flex-direction: column;

    background: #ffffff;

    border-right: 1px solid #e5e7eb;

    padding: 26px 14px 18px;
    }


    /* =========================================================
    MENU TITLE
    ========================================================= */

    .sidebar-menu-title {
    padding: 0 12px;
    margin-bottom: 10px;

    color: #9aa1a9;

    font-size: 9px;
    font-weight: 700;

    letter-spacing: 1.5px;
    }


    /* =========================================================
    SIDEBAR NAV
    ========================================================= */

    .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 3px;
    }

    .sidebar-nav a {
    position: relative;

    min-height: 42px;

    padding: 0 12px;

    display: flex;
    align-items: center;

    gap: 11px;

    border-radius: 8px;

    color: #737b84;

    text-decoration: none;

    font-size: 12px;
    font-weight: 550;

    transition:
    background .15s ease,
    color .15s ease,
    transform .15s ease;
    }

    .sidebar-nav a:hover {
    background: #f5f6f8;
    color: #30363c;

    text-decoration: none;

    transform: translateX(1px);
    }


    /* =========================================================
    NAV ICONS
    ========================================================= */

    .nav-icon {
    width: 28px;
    height: 28px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 7px;

    color: #8b939b !important;

    font-size: 14px;
    line-height: 1;

    transition:
    background .15s ease,
    color .15s ease,
    box-shadow .15s ease;
    }


    /* HOVER */

    .sidebar-nav a:hover .nav-icon {
    color: #555d65 !important;
    }


    /* =========================================================
    ACTIVE NAV ITEM
    ========================================================= */

    .sidebar-nav a.active {
    background: #f0f2f4;

    color: #20252b;

    font-weight: 650;
    }

    .sidebar-nav a.active::before {
    content: "";

    position: absolute;

    left: 0;

    top: 9px;
    bottom: 9px;

    width: 3px;

    border-radius: 0 3px 3px 0;

    background: #20252b;
    }

    .sidebar-nav a.active .nav-icon {
    background: #ffffff;

    color: #20252b !important;

    box-shadow:
    0 1px 3px rgba(32, 37, 43, .06);
    }


    /* =========================================================
    SIDEBAR BOTTOM
    ========================================================= */

    .sidebar-bottom {
    margin-top: auto;

    padding-top: 18px;

    border-top: 1px solid #edf0f2;
    }

    .sidebar-bottom a {
    min-height: 38px;

    padding: 0 12px;

    display: flex;
    align-items: center;

    gap: 9px;

    color: #9299a1;

    border-radius: 8px;

    text-decoration: none;

    font-size: 11px;

    transition: .15s ease;
    }

    .sidebar-bottom a:hover {
    background: #f5f6f8;

    color: #555d65;

    text-decoration: none;
    }

    .sidebar-bottom a span {
    font-size: 14px;
    }


    /* =========================================================
    PAGE CONTENT
    ========================================================= */

    .app-content {
    flex: 1;

    min-width: 0;

    background: #f5f6f9;
    }


    /* =========================================================
    FOOTER
    ========================================================= */

    .app-footer {
    min-height: 48px;

    padding: 0 28px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    background: #ffffff;

    border-top: 1px solid #e5e7eb;

    color: #9aa1a9;

    font-size: 10px;
    }

    .app-footer a {
    color: #737b84;

    text-decoration: none;

    transition: .15s ease;
    }

    .app-footer a:hover {
    color: #30363c;

    text-decoration: none;
    }


    /* =========================================================
    RESPONSIVE
    ========================================================= */

    @@media (max-width: 800px) {

    .navbar {
    padding: 0 18px;
    }

    .navbar-home span {
    display: none;
    }

    .app-sidebar {
    width: 70px;

    padding: 22px 10px 14px;
    }

    .sidebar-menu-title {
    display: none;
    }

    .sidebar-nav a {
    justify-content: center;

    padding: 0;

    gap: 0;
    }

    .sidebar-nav a span:last-child {
    display: none;
    }

    .nav-icon {
    width: 34px;
    height: 34px;
    }

    .sidebar-nav a.active::before {
    left: -10px;
    }

    .sidebar-bottom a {
    justify-content: center;

    padding: 0;
    }

    .sidebar-bottom a {
    font-size: 0;
    }

    .sidebar-bottom a span {
    font-size: 16px;
    }
    }


    /* =========================================================
    SMALL MOBILE
    ========================================================= */

    @@media (max-width: 500px) {

    .app-sidebar {
    width: 58px;

    padding-left: 7px;
    padding-right: 7px;
    }

    .navbar-logo {
    width: 33px;
    height: 33px;
    }

    .logout-button,
    .login-button {
    padding: 0 10px;
    }

    .app-footer {
    padding: 0 15px;
    }
    }
</style>

