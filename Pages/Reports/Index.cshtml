
@page
@model ServerRoomMonitor.Pages.Reports.IndexModel

@{
    ViewData["Title"] = "Reports";
}

<div class="container mt-4 reports-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="reports-title">Reports</h1>
            <p class="text-muted mb-0">
                Server room inspection and monitoring overview.
            </p>
        </div>

        <div>
            <a asp-page-handler="GeneratePdf"
               class="btn btn-primary">
                <i class="bi bi-file-earmark-pdf"></i>
                Generate PDF
            </a>
        </div>
    </div>


    <!-- SUMMARY -->
    <div class="row g-3 mb-4">

        <div class="col-md-4 col-lg-2">
            <div class="card report-stat-card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Server Rooms</h6>
                    <h2>@Model.TotalRooms</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-2">
            <div class="card report-stat-card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Inspections</h6>
                    <h2>@Model.TotalInspections</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-2">
            <div class="card report-stat-card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Passed</h6>
                    <h2 class="text-success">@Model.SuccessfulInspections</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-2">
            <div class="card report-stat-card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Failed</h6>
                    <h2 class="text-danger">@Model.FailedInspections</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-2">
            <div class="card report-stat-card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Overdue</h6>
                    <h2 class="text-warning">@Model.OverdueRooms</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-2">
            <div class="card report-stat-card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Compliance</h6>
                    <h2>@Model.ComplianceRate%</h2>
                </div>
            </div>
        </div>

    </div>


    <!-- SERVER ROOM STATUS -->
    <div class="card report-card mb-4">

        <div class="card-header report-card-header">
            <div>
                <strong>Server Room Status</strong>
                <div class="small text-muted">
                    Inspection status for each server room
                </div>
            </div>

            <span class="report-count">
                @Model.RoomReports.Count rooms
            </span>
        </div>

        <div class="table-responsive">

            <table class="table table-hover mb-0 report-table">

                <thead>
                    <tr>
                        <th>Server Room</th>
                        <th>Location</th>
                        <th>Last Inspection</th>
                        <th>Status</th>
                        <th>Inspections</th>
                        <th>Failures</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var room in Model.RoomReports)
                    {
                        <tr>

                            <td>
                                <strong>@room.Name</strong>
                            </td>

                            <td class="text-muted">
                                @room.Location
                            </td>

                            <td>
                                @if (room.LastInspection.HasValue)
                                {
                                    @room.LastInspection.Value.ToString("dd/MM/yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Never inspected
                                    </span>
                                }
                            </td>

                            <td>
                                @if (!room.LastInspection.HasValue)
                                {
                                    <span class="badge bg-danger">
                                        Never inspected
                                    </span>
                                }
                                else if (room.DaysSinceInspection >= 7)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Overdue
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Up to date
                                    </span>
                                }
                            </td>

                            <td>
                                @room.TotalInspections
                            </td>

                            <td>
                                @if (room.FailedInspections > 0)
                                {
                                    <span class="badge bg-danger">
                                        @room.FailedInspections
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        0
                                    </span>
                                }
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- ROOM PAGINATION -->
        @if (Model.TotalRoomPages > 1)
        {
            <div class="report-pagination">

                <div class="pagination-info">
                    Page @Model.RoomPage of @Model.TotalRoomPages
                </div>

                <div class="pagination-buttons">

                    @if (Model.RoomPage > 1)
                    {
                        <a asp-page="./Index"
                           asp-route-roomPage="@(Model.RoomPage - 1)"
                           asp-route-inspectionPage="@Model.InspectionPage"
                           class="btn btn-sm btn-outline-secondary">
                            Previous
                        </a>
                    }

                    @for (int pageNumber = 1; pageNumber <= Model.TotalRoomPages; pageNumber++)
                    {
                        <a asp-page="./Index"
                           asp-route-roomPage="@pageNumber"
                           asp-route-inspectionPage="@Model.InspectionPage"
                           class="btn btn-sm @(pageNumber == Model.RoomPage ? "btn-primary" : "btn-outline-secondary")">
                            @pageNumber
                        </a>
                    }

                    @if (Model.RoomPage < Model.TotalRoomPages)
                    {
                        <a asp-page="./Index"
                           asp-route-roomPage="@(Model.RoomPage + 1)"
                           asp-route-inspectionPage="@Model.InspectionPage"
                           class="btn btn-sm btn-outline-secondary">
                            Next
                        </a>
                    }

                </div>

            </div>
        }

    </div>


    <!-- RECENT INSPECTIONS -->
    <div class="card report-card mb-4">

        <div class="card-header report-card-header">
            <div>
                <strong>Recent Inspections</strong>
                <div class="small text-muted">
                    Latest inspection activity
                </div>
            </div>

            <span class="report-count">
                @Model.TotalInspectionPages pages
            </span>
        </div>

        <div class="table-responsive">

            <table class="table table-hover mb-0 report-table">

                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Server Room</th>
                        <th>Technician</th>
                        <th>Temperature</th>
                        <th>Result</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var inspection in Model.RecentInspections)
                    {
                        <tr>

                            <td>
                                @inspection.CheckedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                <strong>@inspection.RoomName</strong>
                            </td>

                            <td class="text-muted">
                                @inspection.TechnicianEmail
                            </td>

                            <td>
                                @inspection.Temperature °C
                            </td>

                            <td>
                                @if (inspection.IsOk)
                                {
                                    <span class="badge bg-success">
                                        OK
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Attention required
                                    </span>
                                }
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- INSPECTION PAGINATION -->
        @if (Model.TotalInspectionPages > 1)
        {
            <div class="report-pagination">

                <div class="pagination-info">
                    Page @Model.InspectionPage of @Model.TotalInspectionPages
                </div>

                <div class="pagination-buttons">

                    @if (Model.InspectionPage > 1)
                    {
                        <a asp-page="./Index"
                           asp-route-roomPage="@Model.RoomPage"
                           asp-route-inspectionPage="@(Model.InspectionPage - 1)"
                           class="btn btn-sm btn-outline-secondary">
                            Previous
                        </a>
                    }

                    @for (int pageNumber = 1; pageNumber <= Model.TotalInspectionPages; pageNumber++)
                    {
                        <a asp-page="./Index"
                           asp-route-roomPage="@Model.RoomPage"
                           asp-route-inspectionPage="@pageNumber"
                           class="btn btn-sm @(pageNumber == Model.InspectionPage ? "btn-primary" : "btn-outline-secondary")">
                            @pageNumber
                        </a>
                    }

                    @if (Model.InspectionPage < Model.TotalInspectionPages)
                    {
                        <a asp-page="./Index"
                           asp-route-roomPage="@Model.RoomPage"
                           asp-route-inspectionPage="@(Model.InspectionPage + 1)"
                           class="btn btn-sm btn-outline-secondary">
                            Next
                        </a>
                    }

                </div>

            </div>
        }

    </div>


    <a asp-page="/ServerRooms/Index"
       class="btn btn-secondary mb-4">
        Back to Server Rooms
    </a>

</div>


<style>

    .reports-page {
        max-width: 1400px;
    }

    .reports-title {
        font-weight: 650;
        color: #252a30;
        margin-bottom: 4px;
    }

    /* SUMMARY CARDS */

    .report-stat-card {
        border: 1px solid #e5e7eb;
        border-radius: 9px;
        box-shadow: 0 2px 7px rgba(32, 37, 43, .04);
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .report-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 14px rgba(32, 37, 43, .07);
    }

    .report-stat-card .card-body {
        padding: 17px 18px;
    }

    .report-stat-card h6 {
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .report-stat-card h2 {
        font-size: 25px;
        font-weight: 650;
        margin: 0;
    }


    /* MAIN CARDS */

    .report-card {
        border: 1px solid #e5e7eb;
        border-radius: 9px;
        box-shadow: 0 2px 7px rgba(32, 37, 43, .04);
        overflow: hidden;
    }

    .report-card-header {
        min-height: 62px;
        padding: 13px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #ffffff;
        border-bottom: 1px solid #edf0f2;
    }

    .report-card-header strong {
        font-size: 13px;
        color: #30363c;
    }

    .report-card-header .small {
        font-size: 10px;
        margin-top: 2px;
    }

    .report-count {
        padding: 4px 9px;
        border-radius: 6px;
        background: #f3f4f6;
        color: #737b84;
        font-size: 10px;
        font-weight: 600;
    }


    /* TABLE */

    .report-table {
        font-size: 12px;
    }

    .report-table thead th {
        padding: 12px 16px;
        background: #f8f9fa;
        border-bottom: 1px solid #e5e7eb;
        color: #737b84;
        font-size: 10px;
        font-weight: 650;
        text-transform: uppercase;
        letter-spacing: .3px;
        white-space: nowrap;
    }

    .report-table tbody td {
        padding: 13px 16px;
        vertical-align: middle;
        border-color: #edf0f2;
    }

    .report-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .report-table tbody tr {
        transition: background .12s ease;
    }

    .report-table tbody tr:hover {
        background: #fafbfc;
    }


    /* BADGES */

    .report-table .badge {
        font-size: 10px;
        font-weight: 600;
        padding: 5px 8px;
        border-radius: 5px;
    }


    /* PAGINATION */

    .report-pagination {
        min-height: 62px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid #edf0f2;
        background: #ffffff;
    }

    .pagination-info {
        color: #9299a1;
        font-size: 10px;
    }

    .pagination-buttons {
        display: flex;
        gap: 4px;
    }

    .pagination-buttons .btn {
        min-width: 32px;
        font-size: 10px;
        border-radius: 6px;
    }


    /* BUTTON */

    .reports-page .btn {
        border-radius: 7px;
        font-size: 11px;
        font-weight: 600;
    }


    /* MOBILE */

    @@media (max-width: 700px) {

        .reports-page {
            margin-top: 20px;
        }

        .reports-page > .d-flex {
            align-items: flex-start !important;
            gap: 15px;
            flex-direction: column;
        }

        .report-pagination {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        .pagination-buttons {
            flex-wrap: wrap;
        }

    }

</style>

