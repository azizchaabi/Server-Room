<script>

    document.addEventListener("DOMContentLoaded", function () {

        /*
         * =====================================================
         * RESTORE SCROLL POSITION
         * =====================================================
         *
         * When the user changes pagination, the browser normally
         * reloads the Razor Page and starts again at the top.
         *
         * We save the current scroll position before navigating
         * and restore it after the new page has loaded.
         */

        const savedScroll = sessionStorage.getItem("dashboardScroll");

        if (savedScroll !== null) {

            const scrollPosition = parseInt(savedScroll, 10);

            /*
             * Wait until the page has finished rendering before
             * restoring the position.
             */
            requestAnimationFrame(function () {

                window.scrollTo({
                    top: scrollPosition,
                    behavior: "instant"
                });

            });

            sessionStorage.removeItem("dashboardScroll");
        }


        /*
         * =====================================================
         * PAGINATION CLICK
         * =====================================================
         */

        const paginationLinks = document.querySelectorAll(
            ".pagination-buttons a.page-button"
        );


        paginationLinks.forEach(function (link) {

            link.addEventListener("click", function () {

                /*
                 * Save the exact position where the user clicked.
                 */
                sessionStorage.setItem(
                    "dashboardScroll",
                    window.scrollY.toString()
                );


                /*
                 * Add a subtle fade while the next page loads.
                 */
                const dashboard = document.querySelector(".dashboard");

                if (dashboard) {
                    dashboard.classList.add("page-loading");
                }


                /*
                 * Slightly fade/move the inspection list.
                 */
                const inspectionList =
                    document.querySelector(".inspection-list");

                if (inspectionList) {
                    inspectionList.classList.add("page-changing");
                }

            });

        });

    });

</script>

