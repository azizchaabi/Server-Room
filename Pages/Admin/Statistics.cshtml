@page
@model ServerRoomMonitor.Pages.Admin.StatisticsModel

@{
ViewData["Title"] = "Statistics";
}

<div class="container mt-4">


<!-- Header -->

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="mb-1">Statistics</h1>

        <p class="text-muted mb-0">
            Inspection statistics and server room performance.
        </p>
    </div>

    <a asp-page="/Admin/Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>


<!-- Main Statistics -->

<div class="row g-3 mb-4">

    <div class="col-6 col-lg-3">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-body py-3">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <small class="text-muted">
                            Server Rooms
                        </small>

                        <h3 class="mb-0 mt-1">
                            @Model.TotalRooms
                        </h3>
                    </div>

                    <span class="badge bg-primary">
                        Rooms
                    </span>

                </div>

            </div>

        </div>

    </div>


    <div class="col-6 col-lg-3">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-body py-3">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <small class="text-muted">
                            Inspections
                        </small>

                        <h3 class="mb-0 mt-1">
                            @Model.TotalInspections
                        </h3>
                    </div>

                    <span class="badge bg-secondary">
                        Total
                    </span>

                </div>

            </div>

        </div>

    </div>


    <div class="col-6 col-lg-3">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-body py-3">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <small class="text-muted">
                            Passed
                        </small>

                        <h3 class="mb-0 mt-1 text-success">
                            @Model.SuccessfulInspections
                        </h3>
                    </div>

                    <span class="badge bg-success">
                        OK
                    </span>

                </div>

            </div>

        </div>

    </div>


    <div class="col-6 col-lg-3">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-body py-3">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <small class="text-muted">
                            Failed
                        </small>

                        <h3 class="mb-0 mt-1 text-danger">
                            @Model.FailedInspections
                        </h3>
                    </div>

                    <span class="badge bg-danger">
                        Failed
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- Status Statistics -->

<div class="row g-3 mb-4">

    <div class="col-md-6">

        <div class="card shadow-sm border-0">

            <div class="card-body py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <small class="text-muted">
                            Compliance Rate
                        </small>

                        <h3 class="mb-0 mt-1">
                            @Model.ComplianceRate%
                        </h3>

                    </div>

                    @if (Model.ComplianceRate >= 90)
                    {
                        <span class="badge bg-success">
                            Excellent
                        </span>
                    }
                    else if (Model.ComplianceRate >= 70)
                    {
                        <span class="badge bg-warning text-dark">
                            Needs improvement
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Attention required
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    <div class="col-md-6">

        <div class="card shadow-sm border-0">

            <div class="card-body py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <small class="text-muted">
                            Overdue Rooms
                        </small>

                        <h3 class="mb-0 mt-1 @(Model.OverdueRooms > 0
                            ? "text-danger"
                            : "text-success")">

                            @Model.OverdueRooms

                        </h3>

                    </div>

                    @if (Model.OverdueRooms > 0)
                    {
                        <span class="badge bg-danger">
                            Action required
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            All up to date
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>

</div>


<!-- Charts -->

<div class="row g-3 mb-4">

    <!-- Results -->

    <div class="col-lg-5">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-header bg-white border-bottom">

                <strong>
                    Inspection Results
                </strong>

            </div>

            <div class="card-body">

                @if (Model.TotalInspections > 0)
                {
                    <div style="height: 260px;">
                        <canvas id="inspectionResultsChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        No inspections recorded yet.
                    </div>
                }

            </div>

        </div>

    </div>


    <!-- Timeline -->

    <div class="col-lg-7">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-header bg-white border-bottom">

                <strong>
                    Inspections Over Time
                </strong>

            </div>

            <div class="card-body">

                @if (Model.TotalInspections > 0)
                {
                    <div style="height: 260px;">
                        <canvas id="inspectionTimelineChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        No inspection data available.
                    </div>
                }

            </div>

        </div>

    </div>

</div>


<!-- Server Room Charts -->

<div class="row g-3 mb-4">

    <div class="col-lg-6">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white border-bottom">

                <strong>
                    Inspections by Server Room
                </strong>

            </div>

            <div class="card-body">

                @if (Model.TotalRooms > 0)
                {
                    <div style="height: 300px;">
                        <canvas id="roomInspectionChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        No server rooms have been created yet.
                    </div>
                }

            </div>

        </div>

    </div>


    <div class="col-lg-6">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white border-bottom">

                <strong>
                    Failures by Server Room
                </strong>

            </div>

            <div class="card-body">

                @if (Model.TotalRooms > 0)
                {
                    <div style="height: 300px;">
                        <canvas id="roomFailureChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        No server rooms have been created yet.
                    </div>
                }

            </div>

        </div>

    </div>

</div>


<div class="mb-4">

    <a asp-page="/Admin/Index"
       class="btn btn-outline-secondary">
        Back to Admin Dashboard
    </a>

</div>
    

</div>

@section Scripts {


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    const inspectionDates = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.InspectionDates));

    const inspectionCounts = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.InspectionCounts));

    const roomNames = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.RoomNames));

    const roomInspectionCounts = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.RoomInspectionCounts));

    const roomFailureCounts = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            Model.RoomFailureCounts));


    // Inspection results

    const inspectionResultsCanvas =
        document.getElementById(
            "inspectionResultsChart");

    if (inspectionResultsCanvas) {

        new Chart(inspectionResultsCanvas, {

            type: "doughnut",

            data: {

                labels: [
                    "Passed",
                    "Failed"
                ],

                datasets: [{

                    data: [
                        @Model.SuccessfulInspections,
                        @Model.FailedInspections
                    ]

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                    legend: {
                        position: "bottom"
                    }

                }

            }

        });

    }


    // Inspection timeline

    const inspectionTimelineCanvas =
        document.getElementById(
            "inspectionTimelineChart");

    if (inspectionTimelineCanvas) {

        new Chart(inspectionTimelineCanvas, {

            type: "line",

            data: {

                labels: inspectionDates,

                datasets: [{

                    label: "Inspections",

                    data: inspectionCounts,

                    tension: 0.3,

                    fill: false

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                scales: {

                    y: {

                        beginAtZero: true,

                        ticks: {
                            precision: 0
                        }

                    }

                }

            }

        });

    }


    // Inspections by room

    const roomInspectionCanvas =
        document.getElementById(
            "roomInspectionChart");

    if (roomInspectionCanvas) {

        new Chart(roomInspectionCanvas, {

            type: "bar",

            data: {

                labels: roomNames,

                datasets: [{

                    label: "Inspections",

                    data: roomInspectionCounts

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                scales: {

                    y: {

                        beginAtZero: true,

                        ticks: {
                            precision: 0
                        }

                    }

                }

            }

        });

    }


    // Failures by room

    const roomFailureCanvas =
        document.getElementById(
            "roomFailureChart");

    if (roomFailureCanvas) {

        new Chart(roomFailureCanvas, {

            type: "bar",

            data: {

                labels: roomNames,

                datasets: [{

                    label: "Failures",

                    data: roomFailureCounts

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                scales: {

                    y: {

                        beginAtZero: true,

                        ticks: {
                            precision: 0
                        }

                    }

                }

            }

        });

    }

</script>


}
