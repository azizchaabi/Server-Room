@page
@model ServerRoomMonitor.Pages.Technician.IndexModel

@{
ViewData["Title"] = "Technician Dashboard";
}

<div class="technician-dashboard">


<!-- =========================================================
     HEADER
     ========================================================= -->

<div class="dashboard-header">
    <div>
        <div class="dashboard-eyebrow">
            TECHNICIAN PORTAL
        </div>

        <h1>
            Technician Dashboard
        </h1>

        <p>
            View your assigned inspections and complete scheduled checks.
        </p>
    </div>
</div>

<!-- =========================================================
     FEEDBACK
     ========================================================= -->

@if (TempData["SuccessMessage"] != null)
{
    <div class="feedback-message feedback-success">
        <div class="feedback-icon">
            ✓
        </div>

        <div>
            <strong>Inspection submitted</strong>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="feedback-message feedback-error">
        <div class="feedback-icon">
            !
        </div>

        <div>
            <strong>Inspection result</strong>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    </div>
}

<!-- =========================================================
     TABS
     ========================================================= -->

<div class="dashboard-tabs">

    <button type="button"
            class="dashboard-tab active"
            data-tab="inspections">

        <span>
            Inspections
        </span>

        <strong>
            @Model.ScheduledInspections.Count
        </strong>
    </button>

    <button type="button"
            class="dashboard-tab"
            data-tab="reminders">

        <span>
            Reminders
        </span>

        @if (Model.TotalReminderCount > 0)
        {
            <strong class="tab-alert">
                @Model.TotalReminderCount
            </strong>
        }
        else
        {
            <strong>
                0
            </strong>
        }
    </button>

</div>

<!-- =========================================================
     INSPECTIONS TAB
     ========================================================= -->

<div id="inspections-tab"
     class="dashboard-tab-content active">

    <section class="inspections-section">

        <div class="section-header">

            <div>
                <div class="section-eyebrow">
                    YOUR WORK
                </div>

                <h2>
                    My Scheduled Inspections
                </h2>

                <p>
                    These are the inspections assigned to you by an administrator.
                </p>
            </div>

            <div class="inspection-count">
                @Model.ScheduledInspections.Count

                <span>
                    Assignments
                </span>
            </div>

        </div>

        @if (!Model.ScheduledInspections.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    ✓
                </div>

                <h3>
                    No scheduled inspections
                </h3>

                <p>
                    You currently have no inspections assigned to you.
                </p>

            </div>
        }
        else
        {
            <div class="inspection-list">

                @foreach (var scheduled in Model.ScheduledInspections)
                {
                    var lastInspection =
                        Model.GetLastInspection(scheduled);

                    var canInspect =
                        Model.CanInspect(scheduled);

                    var needsAttention =
                        Model.NeedsAttention(scheduled);

                    <article class="inspection-card">

                        <!-- =================================================
                             CARD HEADER
                             ================================================= -->

                        <div class="inspection-card-header">

                            <div class="inspection-icon">
                                ▦
                            </div>

                            <div class="inspection-title">

                                <h3>
                                    @scheduled.ServerRoom?.Name
                                </h3>

                                <span>
                                    @scheduled.ServerRoom?.Location
                                </span>

                            </div>

                            <div class="inspection-status">

                                @if (scheduled.Status == "Completed")
                                {
                                    <span class="status-badge status-completed">
                                        ✓ Completed
                                    </span>
                                }
                                else if (scheduled.Status == "Requires Fix")
                                {
                                    <span class="status-badge status-fix">
                                        ! Requires Fix
                                    </span>
                                }
                                else if (scheduled.Status == "Awaiting Verification")
                                {
                                    <span class="status-badge status-verification">
                                        ● Awaiting Verification
                                    </span>
                                }
                                else if (scheduled.Status == "Overdue")
                                {
                                    <span class="status-badge status-overdue">
                                        ! Overdue
                                    </span>
                                }
                                else if (scheduled.Status == "In Progress")
                                {
                                    <span class="status-badge status-progress">
                                        ● In Progress
                                    </span>
                                }
                                else if (scheduled.Status == "Cancelled")
                                {
                                    <span class="status-badge status-cancelled">
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-scheduled">
                                        Scheduled
                                    </span>
                                }

                            </div>

                        </div>

                        <!-- =================================================
                             REMINDER MESSAGE
                             ================================================= -->

                        @if (needsAttention)
                        {
                            <div class="scheduled-reminder">

                                <div class="scheduled-reminder-icon">
                                    !
                                </div>

                                <div>
                                    <strong>
                                        Inspection reminder
                                    </strong>

                                    <span>
                                        @Model.GetScheduledReminderMessage(scheduled)
                                    </span>
                                </div>

                            </div>
                        }

                        <!-- =================================================
                             INFORMATION
                             ================================================= -->

                        <div class="inspection-information">

                            <div class="information-item">

                                <span class="information-label">
                                    SCHEDULED
                                </span>

                                <strong>
                                    @scheduled.ScheduledAt.ToString("dd/MM/yyyy HH\\:mm")
                                </strong>

                            </div>

                            <div class="information-item">

                                <span class="information-label">
                                    DEADLINE
                                </span>

                                <strong>
                                    @scheduled.Deadline.ToString("dd/MM/yyyy HH\\:mm")
                                </strong>

                            </div>

                            <div class="information-item">

                                <span class="information-label">
                                    ATTEMPTS
                                </span>

                                <strong>
                                    @scheduled.AttemptCount / 3
                                </strong>

                            </div>

                            <div class="information-item">

                                <span class="information-label">
                                    LAST RESULT
                                </span>

                                @if (lastInspection == null)
                                {
                                    <strong class="muted">
                                        Not performed
                                    </strong>
                                }
                                else if (lastInspection.IsOk)
                                {
                                    <strong class="result-success">
                                        ✓ Passed
                                    </strong>
                                }
                                else
                                {
                                    <strong class="result-failed">
                                        ! Failed
                                    </strong>
                                }

                            </div>

                        </div>

                        <!-- =================================================
                             LAST RESULT DETAILS
                             ================================================= -->

                        @if (lastInspection != null)
                        {
                            <div class="last-result">

                                <span>
                                    Last inspection:
                                </span>

                                <strong>
                                    @lastInspection.CheckedAt.ToString("dd/MM/yyyy HH\\:mm")
                                </strong>

                                <span>
                                    by
                                </span>

                                <strong>
                                    @(lastInspection.Technician?.Email ?? "Unknown")
                                </strong>

                            </div>
                        }

                        <!-- =================================================
                             NOTES
                             ================================================= -->

                        @if (!string.IsNullOrWhiteSpace(scheduled.Notes))
                        {
                            <div class="scheduled-notes">

                                <span class="information-label">
                                    ADMINISTRATOR NOTES
                                </span>

                                <p>
                                    @scheduled.Notes
                                </p>

                            </div>
                        }

                        <!-- =================================================
                             ACTIONS
                             ================================================= -->

                        <div class="inspection-actions">

                            @if (canInspect)
                            {
                                <a asp-page="/Inspections/Create"
                                   asp-route-scheduledInspectionId="@scheduled.Id"
                                   class="primary-button">

                                    @(scheduled.Status == "Awaiting Verification"
                                        ? "Verify Room"
                                        : scheduled.AttemptCount == 0
                                            ? "Start Inspection"
                                            : "Perform Next Attempt")

                                    <span>
                                        →
                                    </span>

                                </a>
                            }
                            else if (scheduled.Status == "Completed")
                            {
                                <span class="action-information completed-action">
                                    Inspection completed
                                </span>
                            }
                            else if (scheduled.Status == "Requires Fix")
                            {
                                <span class="action-information fix-action">
                                    Waiting for administrator
                                </span>
                            }
                            else if (scheduled.Status == "Awaiting Verification")
                            {
                                <span class="action-information verification-action">
                                    Verification available
                                </span>
                            }
                            else if (scheduled.Status == "Overdue")
                            {
                                <span class="action-information overdue-action">
                                    Deadline passed
                                </span>
                            }
                            else if (scheduled.Status == "Cancelled")
                            {
                                <span class="action-information">
                                    Inspection cancelled
                                </span>
                            }
                            else
                            {
                                <span class="action-information">
                                    Inspection not available yet
                                </span>
                            }

                        </div>

                    </article>
                }

            </div>
        }

    </section>

</div>

<!-- =========================================================
     REMINDERS TAB
     ========================================================= -->

<div id="reminders-tab"
     class="dashboard-tab-content">

    <section class="reminders-section">

        <div class="section-header">

            <div>

                <div class="section-eyebrow">
                    ATTENTION REQUIRED
                </div>

                <h2>
                    Inspection Reminders
                </h2>

                <p>
                    Scheduled inspections and other inspection reminders that require your attention.
                </p>

            </div>

            <div class="inspection-count">

                @Model.TotalReminderCount

                <span>
                    Reminders
                </span>

            </div>

        </div>

        @if (Model.TotalReminderCount == 0)
        {
            <div class="empty-state">

                <div class="empty-icon">
                    ✓
                </div>

                <h3>
                    No reminders
                </h3>

                <p>
                    You currently have no inspection reminders.
                </p>

            </div>
        }
        else
        {
            <div class="reminder-list">

                <!-- =====================================================
                     SCHEDULED INSPECTION REMINDERS
                     ===================================================== -->

                @foreach (var scheduled in Model.ActiveScheduledReminders)
                {
                    var canInspect =
                        Model.CanInspect(scheduled);

                    <article class="reminder-card scheduled-reminder-card">

                        <div class="reminder-icon">
                            !
                        </div>

                        <div class="reminder-content">

                            <div class="reminder-title">

                                <h3>
                                    @scheduled.ServerRoom?.Name
                                </h3>

                                @if (!string.IsNullOrWhiteSpace(
                                    scheduled.ServerRoom?.Location))
                                {
                                    <span>
                                        @scheduled.ServerRoom.Location
                                    </span>
                                }

                            </div>

                            <p>
                                @Model.GetScheduledReminderMessage(scheduled)
                            </p>

                            <div class="reminder-meta">

                                <span>
                                    Scheduled
                                </span>

                                <strong>
                                    @scheduled.ScheduledAt.ToString("dd/MM/yyyy HH\\:mm")
                                </strong>

                                <span>
                                    · Deadline
                                </span>

                                <strong>
                                    @scheduled.Deadline.ToString("dd/MM/yyyy HH\\:mm")
                                </strong>

                                <span>
                                    · Attempts
                                </span>

                                <strong>
                                    @scheduled.AttemptCount/3
                                </strong>

                            </div>

                            @if (canInspect)
                            {
                                <div class="reminder-action">

                                    <a asp-page="/Inspections/Create"
                                       asp-route-scheduledInspectionId="@scheduled.Id"
                                       class="primary-button">

                                        @(scheduled.Status == "Awaiting Verification"
                                            ? "Verify Room"
                                            : scheduled.AttemptCount == 0
                                                ? "Start Inspection"
                                                : "Perform Next Attempt")

                                        <span>
                                            →
                                        </span>

                                    </a>

                                </div>
                            }
                            else if (scheduled.Status == "Overdue")
                            {
                                <div class="reminder-action">

                                    <span class="action-information overdue-action">
                                        Deadline passed
                                    </span>

                                </div>
                            }
                            else if (scheduled.Status == "Requires Fix")
                            {
                                <div class="reminder-action">

                                    <span class="action-information fix-action">
                                        Waiting for administrator
                                    </span>

                                </div>
                            }

                        </div>

                    </article>
                }

                <!-- =====================================================
                     EXISTING DATABASE REMINDERS
                     ===================================================== -->

                @foreach (var reminder in Model.Reminders)
                {
                    <article class="reminder-card">

                        <div class="reminder-icon">
                            !
                        </div>

                        <div class="reminder-content">

                            <div class="reminder-title">

                                <h3>
                                    @reminder.ServerRoom?.Name
                                </h3>

                                @if (!string.IsNullOrWhiteSpace(
                                    reminder.ServerRoom?.Location))
                                {
                                    <span>
                                        @reminder.ServerRoom.Location
                                    </span>
                                }

                            </div>

                            <p>
                                @reminder.Message
                            </p>

                            <div class="reminder-meta">

                                <span>
                                    Created
                                </span>

                                <strong>
                                    @reminder.CreatedAt.ToString("dd/MM/yyyy HH\\:mm")
                                </strong>

                            </div>

                        </div>

                    </article>
                }

            </div>
        }

    </section>

</div>


</div>

<style>

    /* =========================================================
       SCHEDULED INSPECTION REMINDER
       ========================================================= */

    .scheduled-reminder {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 12px 20px;
        background: #faf6ea;
        border-top: 1px solid #f0e7d2;
        border-bottom: 1px solid #f0e7d2;
    }

    .scheduled-reminder-icon {
        width: 28px;
        height: 28px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        background: #f8e9c8;
        color: #a27522;
        font-size: 12px;
        font-weight: 800;
    }

    .scheduled-reminder strong {
        display: block;
        margin-bottom: 2px;
        color: #8b681f;
        font-size: 9px;
        font-weight: 750;
    }

    .scheduled-reminder span {
        display: block;
        color: #8f7b55;
        font-size: 9px;
    }

    .scheduled-reminder-card {
        border-left: 3px solid #d8b66a;
    }

    .reminder-action {
        display: flex;
        align-items: center;
        margin-top: 11px;
    }

    /* =========================================================
       EXISTING DASHBOARD STYLES
       ========================================================= */

    .technician-dashboard {
        max-width: 1200px;
        margin: 0 auto;
        padding: 42px 40px 60px;
    }

    .dashboard-header {
        margin-bottom: 32px;
    }

    .dashboard-eyebrow,
    .section-eyebrow {
        color: #9299a1;
        font-size: 9px;
        font-weight: 750;
        letter-spacing: 1.7px;
        margin-bottom: 8px;
    }

    .dashboard-header h1 {
        margin: 0;
        color: #20252b;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -.5px;
    }

    .dashboard-header p {
        margin: 9px 0 0;
        color: #858d96;
        font-size: 13px;
    }

    .feedback-message {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 14px 17px;
        margin-bottom: 30px;
        border-radius: 9px;
        border: 1px solid;
    }

    .feedback-success {
        background: #edf6f0;
        border-color: #d6e9dc;
        color: #39794e;
    }

    .feedback-error {
        background: #f9eded;
        border-color: #efd5d5;
        color: #b33e3e;
    }

    .feedback-icon {
        width: 30px;
        height: 30px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        background: rgba(255,255,255,.65);
        font-weight: 800;
    }

    .feedback-message strong {
        display: block;
        font-size: 11px;
        margin-bottom: 2px;
    }

    .feedback-message span {
        display: block;
        font-size: 10px;
    }

    .dashboard-tabs {
        display: flex;
        gap: 5px;
        margin-bottom: 24px;
        padding: 4px;
        width: fit-content;
        background: #f1f3f5;
        border: 1px solid #e5e7eb;
        border-radius: 9px;
    }

    .dashboard-tab {
        min-height: 35px;
        padding: 0 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid transparent;
        border-radius: 6px;
        background: transparent;
        color: #858d96;
        font-family: inherit;
        font-size: 10px;
        font-weight: 650;
        cursor: pointer;
        transition: background .15s ease, color .15s ease,
                    border-color .15s ease, box-shadow .15s ease;
    }

    .dashboard-tab:hover {
        color: #4f5861;
    }

    .dashboard-tab.active {
        background: #ffffff;
        border-color: #e5e7eb;
        color: #20252b;
        box-shadow: 0 2px 5px rgba(32, 37, 43, .05);
    }

    .dashboard-tab strong {
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
        background: #f1f3f5;
        color: #8b939b;
        font-size: 8px;
        font-weight: 750;
    }

    .dashboard-tab.active strong {
        background: #eef0f2;
        color: #626b74;
    }

    .dashboard-tab strong.tab-alert {
        background: #f9eded;
        color: #b33e3e;
    }

    .dashboard-tab-content {
        display: none;
    }

    .dashboard-tab-content.active {
        display: block;
    }

    .section-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .section-header h2 {
        margin: 0;
        color: #252a30;
        font-size: 19px;
        font-weight: 700;
        letter-spacing: -.2px;
    }

    .section-header p {
        margin: 6px 0 0;
        color: #9299a1;
        font-size: 11px;
    }

    .inspection-count {
        min-width: 80px;
        height: 34px;
        padding: 0 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #ffffff;
        color: #4f5861;
        font-size: 11px;
        font-weight: 700;
    }

    .inspection-count span {
        color: #9ba1a8;
        font-weight: 500;
    }

    .inspection-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .inspection-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 11px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(32, 37, 43, .025);
        transition: transform .15s ease, box-shadow .15s ease,
                    border-color .15s ease;
    }

    .inspection-card:hover {
        transform: translateY(-1px);
        border-color: #d9dde1;
        box-shadow: 0 7px 20px rgba(32, 37, 43, .06);
    }

    .inspection-card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 19px 20px;
        border-bottom: 1px solid #f0f1f3;
    }

    .inspection-icon {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #f1f3f5;
        color: #626b74;
        font-size: 16px;
    }

    .inspection-title {
        flex: 1;
        min-width: 0;
    }

    .inspection-title h3 {
        margin: 0;
        color: #252a30;
        font-size: 14px;
        font-weight: 700;
    }

    .inspection-title span {
        display: block;
        margin-top: 4px;
        color: #9299a1;
        font-size: 10px;
    }

    .inspection-status {
        flex-shrink: 0;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        min-height: 26px;
        padding: 0 10px;
        border-radius: 6px;
        font-size: 9px;
        font-weight: 700;
    }

    .status-scheduled {
        background: #f1f3f5;
        color: #68717a;
    }

    .status-progress {
        background: #f8f1e5;
        color: #a27522;
    }

    .status-completed {
        background: #edf6f0;
        color: #39794e;
    }

    .status-fix,
    .status-overdue {
        background: #f9eded;
        color: #b33e3e;
    }

    .status-verification {
        background: #edf1f7;
        color: #526b91;
    }

    .status-cancelled {
        background: #f1f3f5;
        color: #9299a1;
    }

    .inspection-information {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        padding: 18px 20px;
        gap: 20px;
    }

    .information-item {
        min-width: 0;
    }

    .information-label {
        display: block;
        margin-bottom: 7px;
        color: #9aa1a9;
        font-size: 8px;
        font-weight: 750;
        letter-spacing: 1.2px;
    }

    .information-item strong {
        color: #4f5861;
        font-size: 11px;
        font-weight: 650;
    }

    .muted {
        color: #a0a6ad !important;
        font-weight: 500 !important;
    }

    .result-success {
        color: #39794e !important;
    }

    .result-failed {
        color: #b33e3e !important;
    }

    .last-result {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 11px 20px;
        background: #fafbfc;
        border-top: 1px solid #f0f1f3;
        color: #9299a1;
        font-size: 9px;
    }

    .last-result strong {
        color: #68717a;
        font-weight: 600;
    }

    .scheduled-notes {
        padding: 14px 20px;
        border-top: 1px solid #f0f1f3;
    }

    .scheduled-notes p {
        margin: 5px 0 0;
        color: #69727b;
        font-size: 10px;
    }

    .inspection-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding: 14px 20px;
        background: #fafbfc;
        border-top: 1px solid #f0f1f3;
    }

    .primary-button {
        min-height: 35px;
        padding: 0 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 7px;
        text-decoration: none;
        background: #20252b;
        border: 1px solid #20252b;
        color: #ffffff;
        font-family: inherit;
        font-size: 10px;
        font-weight: 650;
        transition: background .15s ease, transform .15s ease;
    }

    .primary-button:hover {
        background: #30363c;
        border-color: #30363c;
        color: #ffffff;
        text-decoration: none;
        transform: translateY(-1px);
